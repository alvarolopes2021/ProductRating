# Supabase
# Project URL (Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=
# Service role key (Settings -> API -> Project API keys -> service_role).
# SERVER ONLY. Never expose this value to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Session
# Secret used to sign the pr_session cookie (for example: openssl rand -hex 32).
# SERVER ONLY. Required for sign-in.
SESSION_SECRET=

# AI summaries
# Key used by the Mastra product-summary agent (openai/gpt-4o-mini).
# SERVER ONLY. Without it, product pages skip AI summary generation.
OPENAI_API_KEY=
